# ============================================================
#  配置文件（新手版）
#  这个文件叫 .env，程序第一次启动时会自动复制一份。
#  ★ 全部可以不填！不填任何密钥也能正常使用内置的离线助手。
#  ★ 等号左边是程序要读的名字，不要改；只改等号右边。
#  ★ 改完之后要完全退出程序，再双击「一键启动.bat」才生效。
# ============================================================

# 【第 1 组】基本设置（一般不用改）
# PORT = 程序占用的门牌号。如果被别的软件占了，改成 8788。
PORT=8787
# HOST = 只允许哪台电脑访问。127.0.0.1 表示只有本机能用，最安全。
HOST=127.0.0.1
# CLIENT_TOKEN = 客户端连接口令。只在自己电脑上用可以不管；
# 如果要给同事连到这台机器，务必改成一串自己想的复杂字符。
CLIENT_TOKEN=dev-client-token-change-me

# 【第 2 组】文件夹位置（一般不用改）
# KB_ROOT = 你的报价表、产品图、证书放在哪（只读，AI 不会改动这些文件）
KB_ROOT=./data/客服资料库
# DB_PATH = 运行记录存在哪（谁在什么时候生成/发送了什么）
DB_PATH=./data/gateway.db

# 【第 3 组】企业微信（暂时用不到，留空即可）
# WECHAT_TOKEN = 企业微信回调的签名密钥。留空表示不验签，仅适合本机试用。
WECHAT_TOKEN=
# 签名方式：HMAC_SHA256(密钥, 规范化的消息内容)，放在 x-signature 请求头里
WECHAT_SIGNATURE_MODE=canonical_json

# 【第 4 组】AI 密钥（想用联网的 AI 才需要填）
# 重要：密钥只存在这台电脑的后台服务里，界面和客户端都看不到，也不会发给客户。
# 建议用「一键启动.bat」的菜单 5 来填写，不用手动改这里。
# 不同厂家的密钥要填在对应那一行；填错行就会一直显示「暂不可用」。
# ZHIPU_API_KEY = 智谱 GLM（bigmodel.cn）的密钥，样子是「一串数字.一串字母」，
#                 在 https://open.bigmodel.cn/ 右上角「API Keys」里创建。
ZHIPU_API_KEY=
# ZHIPU_MODEL = 智谱用哪个模型。留空 = glm-4.5-air（速度快、便宜、够用）；
#               想更聪明可以填 glm-4.6 / glm-5.3-flash（会慢一点、可能更贵）。
ZHIPU_MODEL=
# DASHSCOPE_API_KEY = 阿里云百炼 / 通义千问的密钥（通常是 sk- 开头）
DASHSCOPE_API_KEY=
# OPENAI_COMPAT_API_KEY = OpenAI 或其他兼容服务的密钥
OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_ENDPOINT / OPENAI_COMPAT_MODEL = 换别家 OpenAI 兼容服务时才填。
#   留空 = 用官方 https://api.openai.com/v1 + gpt-4o。
#   例如 DeepSeek：OPENAI_COMPAT_ENDPOINT=https://api.deepseek.com/v1
#                  OPENAI_COMPAT_MODEL=deepseek-chat
OPENAI_COMPAT_ENDPOINT=
OPENAI_COMPAT_MODEL=
# LANGGRAPH_TOKEN = 公司自研 AI 服务的密钥（没部署就留空）
LANGGRAPH_TOKEN=
# OLLAMA_KEY = 本机 Ollama 一般不需要密钥，留空即可
OLLAMA_KEY=

# 【第 5 组】桌面窗口版去哪里找后台服务（一般不用改）
GATEWAY_URL=http://127.0.0.1:8787
